        Console.WriteLine("Luong co ban: " + ql.BaseSalary + " VND");
        Console.WriteLine("Phu cap: " + ql.ResponsibilityAllowance + " VND");
        Console.WriteLine("Thu nhap: " + ql.CalculateIncome() + " VND");

        Console.ReadKey();
    }
}
